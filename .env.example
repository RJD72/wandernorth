# Build classification: development, preview, or production.
EXPO_PUBLIC_APP_ENV=development

# Offline fixtures are development-only by default.
EXPO_PUBLIC_USE_DEMO_DATA=false
EXPO_PUBLIC_ALLOW_BETA_DEMO_DATA=false

# Public/extractable Android Maps SDK key. Restrict to Maps SDK for Android,
# com.rob.wandernorth, and the correct signing-certificate SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Public/extractable mobile web-service key for Routes API and Places API (New).
# Use a different value in each EAS environment and never reuse a web key.
EXPO_PUBLIC_GOOGLE_WEB_SERVICES_API_KEY=

# Required restriction headers for the mobile web-service credential.
EXPO_PUBLIC_ANDROID_PACKAGE_NAME=
EXPO_PUBLIC_ANDROID_CERT_SHA1=

# Public/extractable TomTom key and explicit provider switch.
EXPO_PUBLIC_TOMTOM_API_KEY=
EXPO_PUBLIC_ENABLE_TOMTOM_POIS=false

# Optional public HTTPS form or mailto link shown to beta testers.
EXPO_PUBLIC_BETA_FEEDBACK_URL=
